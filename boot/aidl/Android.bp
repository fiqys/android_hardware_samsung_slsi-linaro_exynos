cc_binary {
    name: "android.hardware.boot-service.exynos",
    relative_install_path: "hw",
    init_rc: ["android.hardware.boot-service.exynos.rc"],
    vintf_fragments: ["android.hardware.boot-service.exynos.xml"],
    vendor: true,
    recovery_available: true,

    srcs: [
        "main.cpp",
        "BootControl.cpp",
    ],

    shared_libs: [
        "liblog",
        "libbase",
        "libbinder_ndk",
        "libhidlbase",
        "libhardware",
        "libutils",
        "android.hardware.boot@1.0",
        "android.hardware.boot@1.1",
        "android.hardware.boot@1.2",
        // TODO: confirm this matches the frozen android.hardware.boot AIDL
        // version actually shipped by this branch's hardware/interfaces
        // (check boot/aidl/aidl_api/android.hardware.boot/) before building.
        "android.hardware.boot-V2-ndk",
    ],
    static_libs: [
        "exsl.v1_2.defaults",
        "exynos_bootctrl_1.2_lib",
        "lib_exynos_message",
        "lib_exbc.v1",
        "libfstab",
    ],
}
